# Detector environment. Copy to .env (which is gitignored) and edit.
#
# NOTHING HERE IS REQUIRED. Every value below is the built-in default, so a detector started with an
# empty environment behaves exactly as it ships. The same settings can be given in a YAML file
# (--config) -- see config.example.yaml, which documents each one and is asserted by the test suite
# to equal these defaults.
#
# Precedence, each layer overriding the last and only where it speaks:
#     built-in defaults  <  --config file  <  environment  <  command-line flags
#
# NAMING: WSM_<SECTION>__<FIELD>, with EXACTLY ONE double underscore. Case does not matter.
# Variables without the WSM_ prefix are ignored, because the process environment is full of other
# people's variables.
#
# A WSM_-prefixed variable that names no setting is FATAL AT STARTUP, and the error names the key.
# That is the most valuable rule in the loader: WSM_KAFKA__BOOTSTRAP_SERVER, singular, would
# otherwise leave a rig publishing to localhost for weeks, with an empty dashboard and nothing
# logged.
#
# THE DETECTOR DOES NOT READ THIS FILE ITSELF. It reads the process environment. Use
# `docker compose --env-file`, your orchestrator's secret/config mechanism, or
# `set -a; . ./.env; set +a` in a shell before launching.


# --- thresholds --------------------------------------------------------------

# Minimum YOLO confidence for a pose detection to be measured at all. A FRACTION in [0, 1], not a
# percentage: 80 is not 80% here, it is a gate no detection can clear, and the detector would then
# see nothing and report nothing.
#WSM_THRESHOLDS__POSE_CONFIDENCE=0.8

# Minimum YOLO confidence for a PPE or fall detection (no-helmet, no-jacket, fall). This is what
# gates a published violation: lowering it costs false alarms, raising it costs missed ones. The
# trained model's F1 peaks around 0.4; 0.6 is past that peak, trading recall for precision.
#WSM_THRESHOLDS__PPE_CONFIDENCE=0.6

# Minimum per-keypoint confidence for a keypoint to count as visible. Every keypoint an angle is
# measured from must clear this, or that side of the body is skipped entirely.
#WSM_THRESHOLDS__KEYPOINT_VISIBILITY=0.6

# Minimum milliseconds between two published FALL events. A single fall is detected on dozens of
# consecutive frames, and every FALL that reaches the engine emails EVERY user in the database.
# 180000 is 3 minutes.
#WSM_THRESHOLDS__FALL_COOLDOWN_MS=180000

# How long a PPE violation may go undetected before its window is closed and published, in
# milliseconds. Detections flicker: on the baseline footage the no-jacket frames arrive as 27 runs,
# the longest 367 ms, while the engine stores a periodic event only above 3000 ms -- so without this
# tolerance every one of them is dropped downstream in silence. Lower it and windows fragment again;
# raise it and two genuinely separate violations merge into one.
#WSM_THRESHOLDS__PPE_GRACE_MS=1500


# --- upright -----------------------------------------------------------------
# The posture precondition for any gesture that requires one (FRONT_BEND does, ARMS_UP does not):
# somebody sitting down is not bending over. COCO keypoint indices, comma-separated, in
# [end, vertex, end] order -- hip, knee, ankle.

#WSM_UPRIGHT__LEFT_IDX=11,13,15
#WSM_UPRIGHT__RIGHT_IDX=12,14,16

# A person counts as upright above this many degrees, in [0, 180]. Lower it and a seated worker
# starts registering bends. This is NOT FRONT_BEND's release threshold, which happens to be spelled
# with the same number.
#WSM_UPRIGHT__ANGLE_DEGREES=160.0


# --- kafka -------------------------------------------------------------------

# host:port, or a comma-separated list of them.
#WSM_KAFKA__BOOTSTRAP_SERVERS=localhost:9092

# The topic the engine's RawEventService listens on. Both sides have to agree: changing it here
# alone publishes into the void, with no error on either side.
#WSM_KAFKA__TOPIC=rawEvents


# --- camera ------------------------------------------------------------------

# What to watch: a digit for a local webcam index, a video file path, or a stream URL. Overridden by
# --source. Note that a non-numeric source is stamped from media position, so a live stream that
# reports no position gives every frame the same timestamp and collapses every window and throttle.
#WSM_CAMERA__SOURCE=0

# The label stored on every event from this camera and grouped by in the dashboard. Unset means
# "reuse the source", which is what the original sent -- so history from a default rig is filed
# under "0". Setting a name renames the camera from that moment on and orphans everything already
# recorded under the old one. Must not be empty.
#WSM_CAMERA__NAME=


# --- models ------------------------------------------------------------------
# Neither file is in git and neither is downloaded for you. Relative paths resolve against the
# process working directory. Nothing here is opened at load time, so a workstation may configure a
# path only the detector host can see.

#WSM_MODELS__POSE_WEIGHTS=models/yolov8s-pose.pt
#WSM_MODELS__PPE_WEIGHTS=models/best.pt


# --- output ------------------------------------------------------------------

# Where the annotated frame is written, overwritten in place every frame. This is the "video
# stream": the engine serves this one file and the browser polls it. The engine's EVENT_IMAGE_PATH
# must point at the directory this lands in.
#WSM_OUTPUT__ANNOTATED_FRAME_PATH=output_image.jpg

# Whether to write it at all. false on a headless site skips the annotate, the JPEG encode and the
# disk write on every frame; the web app's stream page then shows nothing. Spelled out as
# true/false rather than guessed, because bool("false") is True in Python and an operator switching
# something off would be switching it on. Equivalent to the --no-display flag.
#WSM_OUTPUT__WRITE_ANNOTATED_FRAME=true
