# Engine environment. Copy to .env (which is gitignored) and fill in.
#
# Every variable here is read by src/main/resources/application.yml, which documents each one at the
# point it is used. The split below is not a convention: ProductionConfigurationTest reads that file
# as raw text and pins the exact set of variables that have no committed fallback, so a secret that
# grows a default, or a non-secret that becomes required, fails the build.


# =============================================================================
# REQUIRED. No default anywhere. The application context refuses to start
# without these, which is deliberate: a service that boots with a well-known
# key issues tokens anyone can forge and reports nothing wrong.
# =============================================================================

# SMTP account for outgoing mail. The username is also the From address of every fall alert and
# every password-reset mail, so a committed default would put a wrong, permanent sender identity on
# outbound mail instead of failing.
#
# A Gmail app password was committed to this repository's history in the password field. It has been
# removed and the history rewritten, and it STILL HAS TO BE REVOKED in the Google account that
# issued it -- a rewrite cannot reach clones, forks or CI caches that already exist. See SECURITY.md.
MAIL_USERNAME=
MAIL_PASSWORD=

# HS256 signing key for every bearer token the API issues.
# Base64, decoding to at least 256 bits. Generate one with:  openssl rand -base64 48
#
# ROTATE, do not merely set. The previous key is in this repository's git history. Issuing a new one
# stops every already-signed token verifying, which logs every current session out; that is correct.
JWT_SECRET=

# AES key for password-reset links.
# Base64, decoding to 16, 24 or 32 bytes (AES-128/192/256). Generate one with:
#     openssl rand -base64 32
#
# ROTATE FIRST. This key encrypts the token that becomes the ?token= of a reset link and decrypts it
# again to decide whose password to change. The token has no expiry and cannot be revoked, so anyone
# holding this key can mint a valid reset link for any address at any time. It is an account-takeover
# key, and the previous value is in the history. Rotating it invalidates every reset link already
# sent -- which is right, because every one of them is forgeable.
PASSWORD_RESET_AES_KEY=


# =============================================================================
# OPTIONAL. Each has a default that works on a fresh checkout; the values below
# ARE those defaults. Uncomment only what you are changing.
# =============================================================================

# The zone in which "which day did this happen on" is answered, for every surface that answers it:
# the countable chart, the periodic chart, the emailed PDF report and the fall alert's Detection
# Time. Must be an IANA zone id -- ZoneId.of rejects three-letter abbreviations, so a typo fails
# startup rather than quietly behaving as UTC. Set it to the worksite's own zone (e.g.
# Europe/Istanbul) to get local days; all four surfaces move together.
#APP_TIMEZONE=UTC

# Origin of the web app, used to build the password-reset link. This was hardcoded to
# http://localhost:3000, so every reset mail a deployed instance sent pointed the recipient at their
# own machine. No trailing slash needed.
#APP_FRONTEND_BASE_URL=http://localhost:3000

# Origins allowed to call this API from a browser. Comma-separated, exact matches only.
# MUST NOT be "*": SecurityConfiguration refuses a wildcard at startup rather than accepting a value
# that reinstates the defect this property exists to close.
#APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Directory holding output_image.jpg -- the single frame the detector overwrites and
# /event/get_image/{timestamp} serves as the "video stream". The default is relative and resolves
# against the engine's working directory, which the documented run command (./mvnw spring-boot:run
# from engine/) makes engine/. Launching from the repository root needs this set explicitly.
#EVENT_IMAGE_PATH=../detector/
