# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist

# local env files -- .env.example is committed on purpose, everything else is
# machine-local. Anything VITE_-prefixed is inlined into the bundle, so these
# files must never hold a secret regardless.
.env
.env.*
!.env.example

# vite
vite.config.js.timestamp-*
.vite

# misc
.DS_Store

npm-debug.log*
yarn-debug.log*
yarn-error.log*
