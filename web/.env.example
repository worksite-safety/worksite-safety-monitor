# Copy to .env (or .env.local) and adjust. Only variables prefixed with VITE_
# are exposed to client code -- and everything here ends up in the shipped
# bundle, so never put a secret in this file.

# Base URL of the engine REST API, with no trailing path.
# Used for every API call (src/util/axios.js) and for the video preview frames
# (src/pages/VideoStream.jsx). Defaults to http://localhost:8080 when unset.
VITE_API_URL=http://localhost:8080
