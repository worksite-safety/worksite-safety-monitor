# ---------------------------------------------------------------------------
# Copy this file to `.env` (same directory as docker-compose.yml) and supply
# the two secrets it leaves empty. Compose reads `.env` automatically; `.env`
# is gitignored and this file is not.
#
#     ./scripts/init-env.sh
#
# does the copy and generates the two keys for you, and refuses to touch a
# `.env` that already exists - regenerating those keys logs out every session
# and voids every outstanding password-reset link. By hand it is:
#
#     cp .env.example .env
#
# The first four variables have NO defaults anywhere - not here, not in
# engine/src/main/resources/application.yml. That is deliberate and is
# explained at length in that file: a service that boots with a well-known
# signing key issues tokens anyone can forge and reports nothing wrong.
#
# So compose refuses to start without them, with a message naming the variable,
# rather than starting an engine that then dies 119 lines into a Spring stack
# trace (measured, below). If you see
#
#     required variable JWT_SECRET is missing a value: ...
#
# you have not created `.env`, or have left a value blank.
# ---------------------------------------------------------------------------


# === Secrets, required ======================================================

# HS256 signing key for the API's JWTs. Base64, decoding to at least 32 bytes;
# JwtService rejects anything shorter at startup.
#
#     openssl rand -base64 48
#
# LEFT EMPTY DELIBERATELY, and empty is the only value that works here. Empty
# is what the `:?` guard in docker-compose.yml detects, so compose stops before
# it creates a container and tells you this variable's name and the command
# above. A plausible-looking placeholder would satisfy that guard and hand the
# engine a string that is not Base64, which surfaces instead as
#
#     io.jsonwebtoken.io.DecodingException: Illegal base64 character: '-'
#
# on line 119 of a 133-line stack trace, at the fifth "Caused by". Measured, on
# the placeholder this file used to ship - which is why nothing is filled in for
# you now.
#
# GENERATE YOUR OWN, and never reuse one you have seen. A key that has appeared
# in a file anyone can read makes every token it signs forgeable by anyone who
# read it.
JWT_SECRET=

# Encrypts the e-mail address inside a password-reset link, and decrypts it
# again to decide whose password to change. Base64, decoding to 16, 24 or 32
# bytes; PasswordService checks this at startup.
#
#     openssl rand -base64 32
#
# Empty for the same reason as JWT_SECRET, and it fails the same way if it is
# not: a non-Base64 placeholder gets past compose and dies in PasswordService's
# constructor as "PASSWORD_RESET_AES_KEY is not valid Base64", wrapped in a
# BeanInstantiationException the operator has to read down to.
#
# Treat it as an account-takeover key, not a config value: reset tokens do not
# expire and cannot be revoked, so anyone holding this key can mint a valid
# reset link for any address in the database. An earlier version of this
# project hard-coded one; that literal is still in the git history and must
# never be reused anywhere.
PASSWORD_RESET_AES_KEY=

# SMTP account used to send fall alerts and password-reset mail. MAIL_USERNAME
# is also the From address on every message the system sends, which is why it
# has no default either - a default would put a wrong, committed identity on
# outbound mail instead of failing.
#
# FOR A LOCAL DEMO these can be any non-empty strings. Nothing connects to SMTP
# at startup (MailConfig only builds a JavaMailSender), so the stack comes up
# fine; only the two features that actually send mail will fail, and they fail
# where you can see them - a FALL alert logs, and "Send Report" answers 500.
#
# For real mail with Gmail you need a 16-character App Password, not the account
# password. And note: a Gmail app password was committed to this repository
# once. If that is the account you are about to reuse, revoke the old password
# first - a history rewrite does not reach forks, clones or CI caches.
MAIL_USERNAME=demo@example.com
MAIL_PASSWORD=not-a-real-password


# === The demo footage =======================================================

# The detector needs something to watch. No clip ships with this repository -
# worksite footage of identifiable people is not redistributable - so you
# supply one: put any video file in the directory below and name it here.
#
# It is mounted READ-ONLY, and it is a file rather than /dev/video0 on purpose:
# a device passthrough is Linux-only, needs a webcam actually attached, and
# turns "clone and run" into "clone, find a camera, work out your platform's
# device path". A file makes `docker compose up` the same demo everywhere.
DEMO_VIDEO_DIR=./demo
DEMO_VIDEO=worksite.mp4

# Replay the clip when it reaches the end. A video file is finite and
# OpenCvFrameSource is single-pass by design, so without this the detector runs
# once, exits 0, and the preview freezes on the last frame after ~30 seconds.
# Set it to false for a single pass - e.g. when you want a fixed, repeatable
# set of events in the database.
DETECTOR_LOOP=true

# The label stored on every event and grouped by in the dashboard. Without it
# the detector names the camera after its source, and a demo's whole history
# would be filed under "/media/worksite.mp4". Set it to something that names
# the place - "gate-north", "loading-bay" - as soon as the footage is real:
# events already written keep the name they were written with, so renaming
# later splits one camera's history in two rather than correcting it.
CAMERA_NAME=demo-clip


# === Using a real camera instead ============================================
#
# Two changes, and only on Linux (Docker Desktop on Windows and macOS runs the
# engine in a VM that has no path to the host's USB devices - there is no flag
# for this, it is what the VM boundary means):
#
#   1. Add the device to the detector service in docker-compose.yml:
#
#        detector:
#          devices:
#            - "/dev/video0:/dev/video0"
#
#   2. Set the source to the camera index rather than a path:
#
#        WSM_CAMERA__SOURCE=0
#
#      Anything the detector sees that is not a digit and not a URL is treated
#      as a file path, so "0" here means "the first camera in the container".
#
# An IP camera needs neither: it is reachable over the network, so just set
# WSM_CAMERA__SOURCE=rtsp://user:pass@camera.lan/stream1 and leave the mounts
# alone. That is the option to prefer if the detector is not on the same
# machine as the camera anyway.


# === Ports on the host ======================================================

# Change these if something already has the port. Note that WEB_PORT is not
# only where the UI is served: it is also the origin the engine's CORS policy
# trusts and the host in every password-reset link, both derived from it below
# in docker-compose.yml. Changing it here changes all three together.
WEB_PORT=3000
ENGINE_PORT=8080

# Published so you can point mongosh or Compass at the demo database. Comment
# the `ports` entry out in docker-compose.yml if you would rather it were not
# reachable from the host at all.
MONGO_PORT=27017


# === Behaviour ==============================================================

# The zone in which "which day did this happen on" is answered, for every chart
# and for the emailed PDF alike. An IANA zone id; UTC is the default and is
# what the stored data was bucketed by. Set it to the worksite's own zone
# (e.g. Europe/Istanbul) to get local days.
APP_TIMEZONE=UTC
